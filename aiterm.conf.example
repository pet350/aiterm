# *** 0.8.4-alpha: Note: api_key and db_pass are encryped with AES-256-CBC from libssl-dev ***
# unencrtpted/plain text passwords are no longer supposrted in the config file!
# you must use the ouput from the built in ssl function in ./aiterm --master=<master key> --crypt-pw=<string>

# Provider [openai/gemini/groq/openrouter/mistral/ollama]
provider=gemini

# AI Model name. (Working Gemini model listed} 
model=gemini-flash-latest

# Provider API Keys. Leave providers you do not use blank.
OPENAI_KEY={ Encrypted OpenAI key }
GEMINI_KEY={ Encrypted Gemini key }
GROQ_KEY={ Encrypted Groq key }
OPENROUTER_KEY={ Encrypted OpenRouter key }
MISTRAL_KEY={ Encrypted Mistral key }
OLLAMA_KEY=
CUSTOM_KEY={ Encrypted custom-provider key }

# Legacy api_key= is still accepted when upgrading an older 0.9.x config,
# but new configurations should use the provider-specific keys above.

# New version 0.5 MariaDB config
# Database Host
db_host={IP Address of your mysql server}

# Database User
db_user={db username}

# Database Password
db_pass={db Encrypted password with AES-256-CBC, use ./aiterm --master=<master key> --crypt-pw=<unencrypted password>  }

# Database Name
db_name={database name. Example: aiterm_db}

